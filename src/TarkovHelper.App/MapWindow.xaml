<Window x:Class="TarkovHelper.App.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Tarkov Helper - Map" Height="800" Width="1000" Background="#111">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="10">
            <CheckBox x:Name="ShowLootCheckBox" Content="Show loot containers" Foreground="LightGray"
                      DockPanel.Dock="Right" VerticalAlignment="Center"
                      Checked="OnShowLootChanged" Unchecked="OnShowLootChanged" />
            <ComboBox x:Name="MapSelector" DockPanel.Dock="Right" VerticalAlignment="Center"
                      Width="160" Margin="0,0,10,0"
                      DisplayMemberPath="Label" SelectionChanged="OnMapSelectorChanged" />
            <TextBlock x:Name="MapStatusText" Foreground="LightGray"
                       Text="Waiting for map/position data..." />
        </DockPanel>

        <skia:SKElement x:Name="MapCanvas" Grid.Row="1" PaintSurface="OnPaintSurface"
                         SizeChanged="OnSizeChanged" />
    </Grid>
</Window>
